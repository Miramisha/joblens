# Register JobLens at https://dev.hh.ru/ before setting these values.
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://localhost:3000/api/hh/callback
HH_USER_AGENT=JobLens/0.1 (replace-with-your-contact-email)
# 32 random bytes, encoded as base64url. Generate locally; never commit a real key.
TOKEN_ENCRYPTION_KEY=

# Email login: smtp2go (verified single sender) or resend (verified domain).
# Empty EMAIL_PROVIDER keeps existing Resend installations working.
EMAIL_PROVIDER=
SMTP2GO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
AUTH_SECRET=

# Separate 32-byte base64url secret for an external cleanup scheduler.
MAINTENANCE_SECRET=
